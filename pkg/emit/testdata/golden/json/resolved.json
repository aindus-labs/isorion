{
  "networks": {
    "front": {}
  },
  "project": {
    "name": "webapp"
  },
  "services": {
    "api": {
      "depends_on": [
        "db"
      ],
      "environment": {
        "APP_ENV": "production"
      },
      "image": "nginx:1.25",
      "ports": [
        "80:8080"
      ],
      "replicas": 5
    },
    "db": {
      "image": "postgres:16"
    }
  },
  "version": "1.0"
}
